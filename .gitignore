# ───────────────────────────────────────────────────────────────
#  🔐 SECURITY - NEVER COMMIT THESE!
# ───────────────────────────────────────────────────────────────
# Supabase credentials
supabase-keys.json
**/supabase-keys.json

# Environment variables
.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging

# API Keys & Secrets
**/secrets.json
**/credentials.json
**/api-keys.json
google-services.json.backup
firebase-adminsdk-*.json

# Keystores (Android signing)
*.jks
*.keystore
key.properties
upload-keystore.jks

# Private keys
*.pem
*.key
*.p12
*.pfx

